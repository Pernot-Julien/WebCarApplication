@model IEnumerable<WebCarApplication.Models.ViewModels.ListeVoitureViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">

    <h1 class="display-4">Nos Voitures</h1>

    <div class="liste-voitures">

        @foreach (var voiture in Model)
        {
            <div class="carte-voiture">

                <img src="~/images/voitures/@voiture.PhotoUrl"
                     alt="Photo voiture" />

                <div class="infos-voiture">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Voitures"
                           asp-action="Update"
                           asp-route-id="@voiture.Id">
                            Modifier la voiture
                        </a>
                        <form asp-controller="Voitures"
                          asp-action="Delete"
                          asp-route-id="@voiture.Id"
                          method="post"
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette voiture ?');">

                        <button type="submit">
                            Supprimer la voiture
                        </button>

</form>

                    }
                    <h3>Prix de vente</h3>

                    <p>Année : @voiture.Annee</p>

                    <p>Marque : @voiture.Marque</p>

                    <p>Modèle : @voiture.Modele</p>

                    <p>Finition : @voiture.Finition</p>

                </div>

            </div>
        }

    </div>

</div>