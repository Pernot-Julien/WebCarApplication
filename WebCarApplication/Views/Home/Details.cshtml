@model WebCarApplication.Models.ViewModels.ListeVoitureViewModel

@{
    ViewData["Title"] = "Détail du véhicule";
}

<div>
    <h1>@Model.Marque @Model.Modele</h1>

    <a asp-controller="Home" asp-action="Index">
        Retour
    </a>

    <div class="carte-voiture">
        <img src="@Url.Content(Model.PhotoUrl)"
             alt="Photo de @Model.Marque @Model.Modele" />

        <div class="infos-voiture">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="actions-voiture">
                    <p>Vous avez publié cette annonce, vous pouvez la :</p>

                    <a asp-controller="Voitures"
                       asp-action="Update"
                       asp-route-id="@Model.Id">
                        Modifier
                    </a>

                    <form asp-controller="Voitures"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette voiture ?');">

                        <button type="submit">Supprimer</button>
                    </form>
                </div>

                <p class="statut-voiture @(Model.Vendu ? "vendu" : !Model.Disponible ? "indisponible" : "")">
                    @(Model.Vendu ? "Vendu" : Model.Disponible ? "Disponible" : "Indisponible")
                </p>
            }

            <h3>@Model.Prix.ToString("N2") €</h3>
            <p>Année : @Model.Annee</p>
            <p>Marque : @Model.Marque</p>
            <p>Modèle : @Model.Modele</p>
            <p>Finition : @Model.Finition</p>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="description-voiture">
                    <p>Description : @Model.Description</p>
                </div>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                @foreach (var reparation in Model.Reparations)
                {
                    <div class="reparations-voiture">
                        <p>Réparations : @reparation.DescriptionReparation</p>
                        <p>Coût : @reparation.CoutReparation.ToString("N2") €</p>
                    </div>
                }
            }

        </div>
    </div>
</div>
