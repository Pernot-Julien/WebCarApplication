@model WebCarApplication.Models.ViewModels.CreateVoitureViewModel

@{
    ViewData["Title"] = "Ajouter une voiture";
}

<h2>Ajouter une nouvelle voiture</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="CodeVin"></label><br />
        <input asp-for="CodeVin" placeholder="Ex : VF1... (Optionnel)" />
        <span asp-validation-for="CodeVin" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="Annee"></label><br />
        <input asp-for="Annee" type="number" />
        <span asp-validation-for="Annee" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="MarqueId"></label><br />
        <select asp-for="MarqueId" asp-items="Model.MarquesDisponibles">
            <option value="">-- Marque --</option>
        </select>
        <span asp-validation-for="MarqueId" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="ModeleId"></label><br />
        <select asp-for="ModeleId" asp-items="Model.ModelesDisponibles">
            <option value="">-- Modèle --</option>
        </select>
        <span asp-validation-for="ModeleId" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="ModeleFinitionId"></label><br />
        <select asp-for="ModeleFinitionId" asp-items="Model.FinitionsDisponibles">
            <option value="">-- Finition --</option>
        </select>
        <span asp-validation-for="ModeleFinitionId" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="DateAchat"></label><br />
        <input asp-for="DateAchat" type="date" />
        <span asp-validation-for="DateAchat" class="text-danger"></span>
    </div>
    <br />
    <div>
        <label asp-for="DescriptionReparation"></label><br />
        <input asp-for="DescriptionReparation" />
        <span asp-validation-for="DescriptionReparation" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="CoutReparation"></label><br />
        <input asp-for="CoutReparation" type="number" step="0.01" />
        <span asp-validation-for="CoutReparation" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="PrixAchat"></label><br />
        <input asp-for="PrixAchat" type="number" step="0.01" />
        <span asp-validation-for="PrixAchat" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="DateDisponibilite"></label><br />
        <input asp-for="DateDisponibilite" type="date" />
        <span asp-validation-for="DateDisponibilite" class="text-danger"></span>
    </div>
    <br />

    <div>
        <label asp-for="Photo"></label>
        <input asp-for="Photo" type="file" accept="image/*" />
        <span asp-validation-for="Photo" class="text-danger"></span>
    </div> 
    <br />

    <div>
       <a asp-controller="Home" asp-action="Index">
    Retour à l'accueil
</a>

        <button type="submit">Enregistrer la voiture</button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Récupération des trois listes déroulantes
        const marqueSelect = document.getElementById("MarqueId");
        const modeleSelect = document.getElementById("ModeleId");
        const finitionSelect = document.getElementById("ModeleFinitionId");

        // URL des deux actions du contrôleur
        const urlModeles = '@Url.Action("RecupererModelesParMarque", "Voitures")';
        const urlFinitions = '@Url.Action("RecupererFinitionsParModele", "Voitures")';

        // Quand on change de marque
        marqueSelect.addEventListener("change", async function () {

            const marqueId = this.value;

            // On réinitialise les listes Modèle et Finition
            modeleSelect.innerHTML = '<option value="">-- Modèle --</option>';
            finitionSelect.innerHTML = '<option value="">-- Finition --</option>';

            if (!marqueId) {
                return;
            }

            // On demande au contrôleur les modèles de cette marque
            const reponse = await fetch(`${urlModeles}?marqueId=${(marqueId)}`);

            if (!reponse.ok) {
                console.error("Erreur lors du chargement des modèles");
                return;
            }

            const modeles = await reponse.json();

            // On ajoute les modèles dans la deuxième liste
            modeles.forEach(modele => {
                modeleSelect.add(new Option(modele.nom, modele.id));
            });
        });

        // Quand on change de modèle
        modeleSelect.addEventListener("change", async function () {

            const modeleId = this.value;

            // On réinitialise la liste Finition
            finitionSelect.innerHTML = '<option value="">-- Finition --</option>';

            if (!modeleId) {
                return;
            }

            // On demande au contrôleur les finitions de ce modèle
            const reponse = await fetch(`${urlFinitions}?modeleId=${(modeleId)}`);

            if (!reponse.ok) {
                console.error("Erreur lors du chargement des finitions");
                return;
            }

            const finitions = await reponse.json();

            // On ajoute les finitions dans la troisième liste
            finitions.forEach(finition => {
                finitionSelect.add(new Option(finition.nom, finition.id));
            });
        });
    </script>
}
   

