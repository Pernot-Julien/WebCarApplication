
@model WebCarApplication.Models.ViewModels.UpdateVoitureViewModel

@{
    ViewData["Title"] = "Modifier une voiture";
}

<div class="vehicle-form-page">

    <h2>Modifier une voiture</h2>

    <div class="vehicle-form-card">

        <form asp-action="Update" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Id" type="hidden" />

            <div class="disponibilite">
                <p>Disponibilité : </p>
                <div class="disponibilite">
                    <input type="radio" asp-for="Disponible" value="true" id="disponibleOui" />
                    <label for="disponibleOui">Oui</label>

                    <input type="radio" asp-for="Disponible" value="false" id="disponibleNon" />
                    <label for="disponibleNon">Non</label>
                </div>
            </div>

            <div class="disponibilite">
                <p>Vendu : </p>
                <div class="disponibilite">
                    <input type="radio" asp-for="Vendu" value="true" id="venduOui" />
                    <label for="venduOui">Oui</label>

                    <input type="radio" asp-for="Vendu" value="false" id="venduNon" />
                    <label for="venduNon">Non</label>
                </div>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="CodeVin"></label>
                <input asp-for="CodeVin" placeholder="Ex : VF1... (Optionnel)" />
                <span asp-validation-for="CodeVin" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="Annee"></label>
                <input asp-for="Annee" type="number" />
                <span asp-validation-for="Annee" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="MarqueId"></label>
                <select asp-for="MarqueId" asp-items="Model.MarquesDisponibles">
                    <option value="">-- Marque --</option>
                </select>
                <span asp-validation-for="MarqueId" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="ModeleId"></label>
                <select asp-for="ModeleId" asp-items="Model.ModelesDisponibles">
                    <option value="">-- Modèle --</option>
                </select>
                <span asp-validation-for="ModeleId" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="ModeleFinitionId"></label>
                <select asp-for="ModeleFinitionId" asp-items="Model.FinitionsDisponibles">
                    <option value="">-- Finition --</option>
                </select>
                <span asp-validation-for="ModeleFinitionId" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="DateAchat"></label>
                <input asp-for="DateAchat" type="date" />
                <span asp-validation-for="DateAchat" class="text-danger"></span>
            </div>

            <div class="vehicle-form-group">
                <label asp-for="PrixAchat"></label>
                <input asp-for="PrixAchat" type="number" step="0.01" />
                <span asp-validation-for="PrixAchat" class="text-danger"></span>
            </div>

                <div class="vehicle-form-group">
        <label asp-for="DescriptionReparation"></label>
        <input asp-for="DescriptionReparation"
               placeholder="Ex : Remplacement des plaquettes de frein" />
        <span asp-validation-for="DescriptionReparation" class="text-danger"></span>
</div>

<div class="vehicle-form-group">
    <label asp-for="CoutReparation"></label>
    <input asp-for="CoutReparation" type="number" step="0.01" />
    <span asp-validation-for="CoutReparation" class="text-danger"></span>
</div>

            <div class="vehicle-form-group">
                <label asp-for="DateDisponibilite"></label>
                <input asp-for="DateDisponibilite" type="date" />
                <span asp-validation-for="DateDisponibilite" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.PhotoActuelle))
            {
                <div class="vehicle-form-group">
                    <label>Photo actuelle</label>

                   <img src="@Url.Content(Model.PhotoActuelle)"
                         alt="Photo actuelle du véhicule"
                         class="vehicle-current-photo" />

                    <small>Laissez vide pour conserver la photo actuelle.</small>
                </div>
            }

            <div class="vehicle-form-group">
                <label asp-for="Photo" class="vehicle-file-label">
                    <span class="vehicle-file-icon">+</span>
                    <span>Ajouter une nouvelle image</span>
                </label>

                <input asp-for="Photo" type="file" accept="image/*" />

                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>

            <div class="vehicle-form-actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="vehicle-back-link">
                    Retour
                </a>

                <button type="submit" class="vehicle-submit-button">
                    Modifier
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
