<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebCarApplication</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebCarApplication.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar-custom">

            <div class="logo">
                <a asp-controller="Home" asp-action="Index">
                    Express Voitures
                </a>
            </div>

            <div class="menu">
                <a asp-controller="Home" asp-action="Index">
                    Accueil
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Voitures" asp-action="create">
                        Ajouter une voiture
                    </a>
                    <form asp-controller="Compte"
                          asp-action="Logout"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn-logout">
                            Se déconnecter
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Compte" asp-action="Login">
                        Se connecter
                    </a>
                }
            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WebCarApplication - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    const marqueSelect = document.getElementById("MarqueId");
    const modeleSelect = document.getElementById("ModeleId");
    const finitionSelect = document.getElementById("ModeleFinitionId");

    // On vérifie que les trois listes existent sur la page
    if (marqueSelect && modeleSelect && finitionSelect) {

        const urlModeles = '@Url.Action("RecupererModelesParMarque", "Voitures")';
        const urlFinitions = '@Url.Action("RecupererFinitionsParModele", "Voitures")';

        // Changement de marque
        marqueSelect.addEventListener("change", async function () {

            const marqueId = this.value;

            modeleSelect.innerHTML = '<option value="">-- Modèle --</option>';
            finitionSelect.innerHTML = '<option value="">-- Finition --</option>';

            if (!marqueId) return;

            const reponse = await fetch(`${urlModeles}?marqueId=${marqueId}`);

            if (!reponse.ok) return;

            const modeles = await reponse.json();

            modeles.forEach(modele => {
                modeleSelect.add(new Option(modele.nom, modele.id));
            });
        });

        // Changement de modèle
        modeleSelect.addEventListener("change", async function () {

            const modeleId = this.value;

            finitionSelect.innerHTML = '<option value="">-- Finition --</option>';

            if (!modeleId) return;

            const reponse = await fetch(`${urlFinitions}?modeleId=${modeleId}`);

            if (!reponse.ok) return;

            const finitions = await reponse.json();

            finitions.forEach(finition => {
                finitionSelect.add(new Option(finition.nom, finition.id));
            });
        });
    }
</script>
</body>
</html>
